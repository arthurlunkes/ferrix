[Unit]
Description=Ferrix web server and reverse proxy
Documentation=https://arthurlunkes.github.io/ferrix
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ferrix
Group=ferrix
WorkingDirectory=/etc/ferrix
# The first start writes /etc/ferrix/ferrix.yaml (every option documented, a random
# admin token); UMask keeps it, and the admin token in it, private to the ferrix group.
ExecStart=/usr/bin/ferrix run --config /etc/ferrix/ferrix.yaml
ExecReload=/bin/kill -HUP $MAINPID
UMask=0027
# systemd already restarts Ferrix, so its own master process isn't needed.
Environment=FERRIX_SUPERVISOR=0
Restart=on-failure
RestartSec=1s
LimitNOFILE=65536
# Ports 80 and 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
